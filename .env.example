# Copy to .env and fill in. Never commit .env.
# Bot token from @BotFather. Add the bot to your channel as an administrator.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channel id: @your_channel_username or the numeric id (e.g. -1001234567890)
TELEGRAM_CHAT_ID=@your_channel
PORT=3000
# Set to 1 to print Telegram messages to the console instead of sending (local testing)
SKIP_TELEGRAM=0
# Operator panel (/operator). Used only the first time, when data/db.json has no operator yet.
# If OPERATOR_PASSWORD is empty a random password is generated and printed in the console.
# Change later with: npm run operator -- <login> <password>
OPERATOR_LOGIN=admin
OPERATOR_PASSWORD=
